# Server Configuration
PORT=8080
APP_ENV=development

# Database Configuration (MySQL)
DATABASE_DSN=root:@tcp(127.0.0.1:3306)/logikraf_v2?charset=utf8mb4&parseTime=True&loc=Local

# Frontend Static Assets Directory (Relative or Absolute Path)
# Default: ./frontend/dist (or ./frontend-dist)
FRONTEND_DIR=./frontend/dist

# Security & Authentication
JWT_SECRET=your-secure-jwt-secret-key-here

# Xendit / XenPlatform (diisi di Settings/DB `setting("xendit_secret_key")`; ini referensi)
# Buat sub-akun: POST /v3/accounts. Tenant perorangan -> entity INDIVIDUAL.
# Test key: v3 hanya menerima CORPORATION -> set XENDIT_ACCOUNTS_ENTITY_TYPE=CORPORATION.
# Di produksi (Live key), biarkan INDIVIDUAL.
XENDIT_ACCOUNTS_ENTITY_TYPE=INDIVIDUAL
XENDIT_ACCOUNT_COUNTRY=ID
XENDIT_WEBHOOK_RECIPIENT=MASTER_ACCOUNT
# Payouts v3 (butuh API key izin MONEY-OUT + RSA key). Routing bank ID belum ada di enum docs.
XENDIT_PAYOUT_ROUTING_TYPE=BANK_CODE
# KYC (nilai yang belum dikumpulkan UI). Lihat docs/payment-hub-integration-guide.md §9.6.
XENDIT_KYC_ROLE=BUSINESS_OWNER
XENDIT_KYC_MOBILE_COUNTRY_CODE=+62
XENDIT_KYC_MOBILE_NUMBER=
XENDIT_KYC_INDUSTRY_CODE=
XENDIT_KYC_BUSINESS_REGISTRATION_NUMBER=
XENDIT_KYC_BUSINESS_ESTABLISHMENT_DATE=
PLATFORM_WEBSITE_URL=https://smarthub.logikraf.id

# Server Configuration
PORT=8080
APP_ENV=development

# Database Configuration (MySQL)
DATABASE_DSN=root:@tcp(127.0.0.1:3306)/logikraf_v2?charset=utf8mb4&parseTime=True&loc=Local

# Frontend Static Assets Directory (Relative or Absolute Path)
# Default: ./frontend/dist (or ./frontend-dist)
FRONTEND_DIR=./frontend/dist

# Security & Authentication
JWT_SECRET=your-secure-jwt-secret-key-here

# Logikraf Backend — environment template
# Copy to .env and fill real values (do NOT commit .env)
PORT=8081
APP_ENV=production
DATABASE_DSN=[ISI_DI_SINI]            # mysql://user:pass@tcp(127.0.0.1:3306)/logikraf_v2
JWT_SECRET=[ISI_DI_SINI]             # random 32+ char secret
FRONTEND_DIR=/app/frontend/dist
ALLOW_ORIGINS=https://logikraf.id
